TF0TUZoeVUwZDBkRnBIVTBwelEwRRAB\" jslog=\"14326; track:click;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEwcE1GQ0NJb0JBIl0=\" aria-label=\"Действия с отзывом пользователя Xloa Cat\" data-tooltip=\"Действия с отзывом пользователя Xloa Cat\" jsaction=\"pane.wfvdle97.review.actionMenu; keydown:pane.wfvdle97.review.actionMenu; focus:pane.focusTooltip; blur:pane.blurTooltip; keydown:pane.escapeTooltip\"><div class=\"zjA77\"><div class=\"NRH0ac \"></div><span class=\"eaLgGf google-symbols\" aria-hidden=\"true\" style=\"font-size: 18px;\"></span></div></button></div></div><div class=\"g138K\"></div><div class=\"GHT2ce\" data-irrelevant-review-text-id=\"ucc-23\"><div class=\"DU9Pgb\"><span class=\"kvMYJc\" role=\"img\" aria-label=\"1&nbsp;звезда\"><span class=\"hCCjke  google-symbols NhBTye elGi1d\" aria-hidden=\"true\" style=\"font-size: 16px;\"></span><span class=\"hCCjke C1jvA google-symbols NhBTye gnOR4e\" aria-hidden=\"true\" style=\"font-size: 16px;\"></span><span class=\"hCCjke C1jvA google-symbols NhBTye gnOR4e\" aria-hidden=\"true\" style=\"font-size: 16px;\"></span><span class=\"hCCjke C1jvA google-symbols NhBTye gnOR4e\" aria-hidden=\"true\" style=\"font-size: 16px;\"></span><span class=\"hCCjke C1jvA google-symbols NhBTye gnOR4e\" aria-hidden=\"true\" style=\"font-size: 16px;\"></span></span><span class=\"rsqaWe\">вчера</span> <div class=\"J7sVM W8gobe\" jslog=\"125092;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEwcE1GQ0NJb0JBIl0=\">Новый</div><div class=\"Tuisuc\"></div></div><div> <div class=\"MyEned\" tabindex=\"-1\" id=\"ucc-23\" lang=\"ru\"><span class=\"wiI7pd\">Добрый вечер !  Впечатление не очень о заведении .. О гастросете заранее не предупредили, сколько времени придётся ждать. В итоге мы ждали больше часа. Официанты не смогли сказать, когда будет готова еда, и, судя по всему, повара тоже не знали, сколько ещё ждать. Тогда непонятно, зачем предлагать гастросет, если никто не может назвать даже примерное время подачи.\n\nКроме того, сначала нас посадили на сломанный диван — это тоже испортило впечатление от посещения. Но больше всего вопросов осталось именно к блюдам, которые входят в гастросет: долгое ожидание и отсутствие информации о подаче сделали визит неприятным. Хотелось бы, чтобы гостей заранее предупреждали о времени ожидания, а персонал мог дать хотя бы примерный ответ. И мы так и не дождались еду ..</span><div jslog=\"127691\"><div jslog=\"126926;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEzSWNIQ0NRb0FRIl0=\" class=\"PBK6be\"><div><span class=\"RfDO5c\"><span><b>Еда:</b> 1</span><span jslog=\"126957;\"></span></span></div></div><div jslog=\"126926;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEzSWNIQ0NVb0FnIl0=\" class=\"PBK6be\"><div><span class=\"RfDO5c\"><span><b>Сервис:</b> 1</span><span jslog=\"126957;\"></span></span></div></div><div jslog=\"126926;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEzSWNIQ0NZb0F3Il0=\" class=\"PBK6be\"><div><span class=\"RfDO5c\"><span style=\"font-weight: bold;\">Время ожидания</span></span></div><div><span class=\"RfDO5c\"><span>Без ожидания</span><span jslog=\"126957;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEzWWNIQ0Njb0FBIl0=\"></span></span></div></div></div></div></div><div style=\"clear: both;\"></div><div class=\"Upo0Ec\"><button class=\"gllhef\" aria-pressed=\"false\" data-review-id=\"Ci9DQUlRQUNvZENodHljRjlvT25kdlZFcGpSbTF0TUZoeVUwZDBkRnBIVTBwelEwRRAB\" jslog=\"25807; track:click;metadata:WyIwYWhVS0V3anMwN2JDMTRtWUF4VVdRdjRGSFJqNUhhOFEwcE1GQ0NJb0JBIl0=\" aria-label=\"Лайк\" title=\"Лайк\" jsaction=\"pane.wfvdle97.review.toggleThumbsUp; keydown:pane.wfvdle97.review.toggleThumbsUp\"><div class=\"GBkF3d \"><div class=\"Gd9ibe NRH0ac \"></div><span class=\"dSlJg google-symbols\" aria-hidden=\"true\" style=\"font-size: 18px;\"></span><span class=\"NlVald znYl0\"><span>Нравится</span></span></div></button><button class=\"gllhef\" jslog=\"32949; track:click\" data-review-id=\"Ci9DQUlRQUNvZENodHl